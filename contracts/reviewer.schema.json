{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "correctness",
    "confidence",
    "missing_parts",
    "guessing_signal",
    "feedback",
    "title_complete",
    "rationale",
    "evidence_event_ids",
    "citation_ids"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "correctness": {
      "enum": [
        "correct",
        "incorrect",
        "partial",
        "uncertain"
      ]
    },
    "confidence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "missing_parts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "guessing_signal": {
      "enum": [
        "supported",
        "unsupported",
        "unknown"
      ]
    },
    "feedback": {
      "type": "string",
      "minLength": 1
    },
    "title_complete": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "citation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

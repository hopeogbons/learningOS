{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "collection_id",
    "material_revision_id",
    "canonical_url",
    "captured_at",
    "source_language",
    "segments"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "web",
        "captions"
      ]
    },
    "collection_id": {
      "type": "string",
      "minLength": 1
    },
    "material_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_language": {
      "type": "string",
      "minLength": 1
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "citation_id"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "citation_id": {
            "type": "string",
            "minLength": 1
          },
          "paragraph": {
            "type": "integer",
            "minimum": 1
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}

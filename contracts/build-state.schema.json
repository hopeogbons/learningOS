{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "level",
    "next_batch",
    "batches",
    "external_blockers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "level": {
      "enum": [
        "package_prepared",
        "offline_demo_validated",
        "live_workflow_validated",
        "production_candidate",
        "deployed_verified"
      ]
    },
    "next_batch": {
      "type": [
        "string",
        "null"
      ]
    },
    "external_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "batches": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(0[0-9]|1[01])$"
          },
          "status": {
            "enum": [
              "pending",
              "in_progress",
              "passed",
              "blocked",
              "failed"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "outcome",
                "command",
                "cwd",
                "exit_code",
                "artifact"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "outcome": {
                  "enum": [
                    "passed",
                    "failed",
                    "expected_failure",
                    "skipped",
                    "unrun",
                    "blocked"
                  ]
                },
                "command": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "cwd": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "exit_code": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "artifact": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "maintenance_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "scope",
          "status",
          "evidence"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "frontend_lint": {
            "type": "string",
            "minLength": 1
          },
          "frontend_build": {
            "type": "string",
            "minLength": 1
          },
          "synthetic_9kb_pdf_browser_upload": {
            "type": "string",
            "minLength": 1
          },
          "reported_user_pdf_failure": {
            "type": "string",
            "minLength": 1
          },
          "live_drive": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "backend": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "passed",
              "skipped",
              "exit_code"
            ],
            "properties": {
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "skipped": {
                "type": "integer",
                "minimum": 0
              },
              "exit_code": {
                "type": "integer"
              }
            }
          },
          "deployment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_commit",
              "target",
              "status",
              "public_production"
            ],
            "properties": {
              "source_commit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "services": {
                "type": "string",
                "minLength": 1
              },
              "health_ready": {
                "type": "string",
                "minLength": 1
              },
              "brand": {
                "type": "string",
                "minLength": 1
              },
              "small_pdf_original_provenance": {
                "type": "string",
                "minLength": 1
              },
              "data_volume": {
                "type": "string",
                "minLength": 1
              },
              "public_production": {
                "type": "string",
                "minLength": 1
              },
              "merged_pr": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
